<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="?attr/colorSurface"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <ScrollView
        android:id="@+id/omp_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/omp_android_logo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Android"
                    android:src="@drawable/omp_ic_android_logo"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Manager"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Advanced File Management"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/omp_settings_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="12dp"
                    android:src="@drawable/omp_ic_settings"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="?attr/colorOutlineVariant"/>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="18dp"
                android:text="DIRECTORIES"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/omp_root_directory_card"
                style="@style/DirectoryCard"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Root Directory"/>

                    <TextView
                        style="@style/CardSubtitle"
                        android:text="/storage/emulated/0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/omp_root_stats"
                            style="@style/StorageStats"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Calculating…"/>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/omp_root_progress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        app:trackThickness="8dp"
                        app:indicatorColor="?attr/colorPrimary"/>

                    <TextView
                        android:id="@+id/omp_root_summary"
                        style="@style/StorageSummary"
                        android:text="Calculating…"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/omp_storage_directory_card"
                style="@style/DirectoryCard"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="Storage Directory"/>

                    <TextView
                        style="@style/CardSubtitle"
                        android:text="Internal Shared Storage"/>

                    <TextView
                        android:id="@+id/omp_storage_stats"
                        style="@style/StorageStats"
                        android:layout_marginTop="14dp"
                        android:text="Calculating…"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/omp_storage_progress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        app:trackThickness="8dp"
                        app:indicatorColor="?attr/colorSecondary"/>

                    <TextView
                        android:id="@+id/omp_storage_summary"
                        style="@style/StorageSummary"
                        android:text="Calculating…"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="20dp"
                android:text="FILE MANAGEMENT"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/omp_extract_apk"
                    style="@style/ToolCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <LinearLayout style="@style/ToolCardInner">
                        <ImageView style="@style/ToolIcon" android:src="@drawable/omp_ic_package"/>
                        <TextView style="@style/CardTitle" android:text="Extract APK"/>
                        <TextView style="@style/CardSubtitle" android:text="APK Extraction"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/omp_documents"
                    style="@style/ToolCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout style="@style/ToolCardInner">
                        <ImageView style="@style/ToolIcon" android:src="@drawable/omp_ic_document"/>
                        <TextView style="@style/CardTitle" android:text="Documents"/>
                        <TextView style="@style/CardSubtitle" android:text="Manage Documents"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/omp_providers"
                    style="@style/ToolCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <LinearLayout style="@style/ToolCardInner">
                        <ImageView style="@style/ToolIcon" android:src="@drawable/omp_ic_folder"/>
                        <TextView style="@style/CardTitle" android:text="Providers"/>
                        <TextView style="@style/CardSubtitle" android:text="File Providers"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/omp_recycle_bin"
                    style="@style/ToolCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout style="@style/ToolCardInner">
                        <ImageView style="@style/ToolIcon" android:src="@drawable/omp_ic_delete"/>
                        <TextView style="@style/CardTitle" android:text="Recycle Bin"/>
                        <TextView style="@style/CardSubtitle" android:text="Deleted Files"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="20dp"
                android:text="NETWORK &amp; CONNECTIONS"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <include layout="@layout/omp_item_network_ftp"/>
                <include layout="@layout/omp_item_network_connect"/>
                <include layout="@layout/omp_item_network_connections"/>
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="20dp"
                android:text="ADVANCED TOOLS &amp; PLUGINS"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <include layout="@layout/omp_item_advanced_mcp"/>
                <include layout="@layout/omp_item_advanced_shell"/>
                <include layout="@layout/omp_item_advanced_logcat"/>
                <include layout="@layout/omp_item_advanced_layout"/>
                <include layout="@layout/omp_item_advanced_color"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
