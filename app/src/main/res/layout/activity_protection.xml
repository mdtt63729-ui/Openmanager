<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/protectionToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/protection_screen_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/protectionPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protection_select_apk" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/protectionAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/protection_profile"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/protectionProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checkedButton="@id/profileStrong">

                <RadioButton
                    android:id="@+id/profileBasic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_profile_basic" />

                <RadioButton
                    android:id="@+id/profileStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_profile_strong" />

                <RadioButton
                    android:id="@+id/profileMaximum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_profile_maximum" />

                <RadioButton
                    android:id="@+id/profileCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protection_profile_custom" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/protectionUnlock"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/protection_unlock"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/protectionApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/protection_apply" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/protectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/protectionReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/protection_disclaimer"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
